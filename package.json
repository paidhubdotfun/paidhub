{
  "name": "paidhub",
  "version": "1.0.0",
  "private": true,
  "description": "Coins for GitHub repos on pump.fun. Half of every fee goes to the people who wrote the code.",
  "homepage": "https://paidhub.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paidhubdotfun/paidhub.git"
  },
  "keywords": [
    "solana",
    "pump.fun",
    "github",
    "launchpad",
    "creator-fees",
    "open-source"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/bundle.mjs --check && vite build",
    "bundle": "node tools/bundle.mjs",
    "keeper": "node keeper/keeper.mjs",
    "fixtures": "node tools/fixtures.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:chain": "node --test --test-concurrency=1 tests/chain.test.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@pump-fun/pump-sdk": "4.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
