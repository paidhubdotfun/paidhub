# paidhub reads its settings from .config/.env above the repo (or PH_ENV_FILE), never from the repo.
# The site's routes on Vercel take the same names from the project's environment.

# Solana: the first RPC is the one used; getProgramAccounts goes to PH_GPA_RPC (Helius handles it fast)
PH_RPCS=https://your-rpc,https://a-fallback-rpc
PH_GPA_RPC=https://mainnet.helius-rpc.com/?api-key=...
HELIUS_API_KEY=

# The pad's two wallets: public keys for the routes, secret keys for the keeper only
PH_KEEPER_PUBKEY=
PH_POT_PUBKEY=
PH_KEEPER_KEY=
PH_POT_KEY=
# the launch transaction's address lookup table (made once at go-live)
PH_LOOKUP_TABLE=

# Mint keys for launches and the sign-in cookie: 64 random hex characters, server only
PH_SECRET=
PH_SITE_URL=https://paidhub.io

# GitHub: an OAuth app (no scope) for developer sign-in and 5 000 public reads an hour
PH_GH_CLIENT_ID=
PH_GH_CLIENT_SECRET=
# the keeper may use a token instead (it reads `gh auth token` when this is empty)
PH_GITHUB_TOKEN=

# Storage: a Vercel Blob store the keeper writes and the site reads
PH_BLOB_TOKEN=

# Prices (optional, DexScreener is the fallback) and the scout's two sentences (optional)
SOLANATRACKER_DATA_KEY=
OPENROUTER_API_KEY=
JUPITER_API_KEY=
